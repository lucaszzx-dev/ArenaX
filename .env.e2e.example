# Ambiente E2E (Playwright). Opcional: por padrão os E2E usam
# postgresql://arenax:arenax_dev@localhost:5432/arenax_e2e
#
# Copie para .env.e2e apenas se precisar sobrescrever (ex.: CI/remoto).
# O banco SEMPRE precisa se chamar "arenax_e2e" — o Playwright aborta
# caso o nome seja diferente, para nunca atingir o banco de desenvolvimento.
E2E_DATABASE_URL=postgresql://arenax:arenax_dev@localhost:5432/arenax_e2e
